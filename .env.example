# aqeelOS web app settings. You do not need this file: scripts/install.sh sets aqeelOS up, the engine keys are read
# from ~/.hermes/.env, UI_SECRET is made on first start, and the address, time zone and hosts are set in the app
# (System › Settings › This install). Use a copy OUTSIDE the repo (the installer's service reads
# ~/.config/aqeelos/aqeelos.env) only to override something; a value here wins over the app's setting.
# Every value is optional; code defaults are neutral (localhost).

# --- Sign-in ---
# Hash: node app/server.mjs hash 'your password'
UI_PASSWORD_HASH=
# Made on first start and kept in UI_DATA_DIR/ui-secret; set it here only to choose your own. Changing it signs everyone out.
UI_SECRET=
UI_SESSION_DAYS=30
# Set to 1 only for local http development (cookies without Secure).
UI_INSECURE_COOKIE=

# --- Where the app listens / stores data ---
UI_HOST=127.0.0.1
UI_PORT=4400
# Defaults to ../hermes-ui-data next to the repo.
UI_DATA_DIR=
UI_LOG=

# --- Engine (Hermes Agent) connection ---
HERMES_DASH=http://127.0.0.1:9119
HERMES_API=http://127.0.0.1:8642
HERMES_WEBHOOKS=http://127.0.0.1:8644
HERMES_WA_CLOUD=http://127.0.0.1:8090
# Defaults to ~/.hermes (a leading ~ is expanded).
HERMES_HOME=
HERMES_BIN=
CLAUDE_BIN=
# Read from the engine's ~/.hermes/.env when empty (gateway API key and dashboard session token).
API_SERVER_KEY=
HERMES_DASHBOARD_SESSION_TOKEN=
# Unix account home used by scripts (agent-users.sh, nord-vpn.sh).
# Defaults to $HOME.
AQEELOS_HOME=

# --- Public addresses of this install (set in the app; a value here wins) ---
# 1 = the live copy (runs the jobs that change agents), 0 = a test copy. Empty: live only on port 4400.
AQEELOS_LIVE=
PUBLIC_URL=
# Proxies whose forwarding headers (cf-connecting-ip, x-forwarded-for) are believed: addresses or CIDR ranges, comma separated. Default: loopback
# (the reverse proxy or tunnel runs on this host). If your proxy reaches the app from a private network (a Docker network), list that range, e.g.
# TRUSTED_PROXIES=127.0.0.1,::1,10.0.1.0/24. Anything else is identified by its socket address (the sign-in limit counts per address).
TRUSTED_PROXIES=
N8N_URL=
# Domain for agent-published live sites (<name>.LIVE_DOMAIN).
LIVE_DOMAIN=
CODE_HOST=
CODE_PREVIEW_HOST=
UI_SCREEN=http://127.0.0.1:6080

# --- Branding / contact ---
# Engine persona: also settable as branding.name / branding.maker in ~/.hermes/config.yaml.
AQEELOS_BRAND_NAME=aqeelOS
AQEELOS_BRAND_MAKER=
BRAND_LOGO_FALLBACK=/assets/aqeelos-mark.svg
# Shown to people when something needs the owner ("ask <OWNER_CONTACT>").
OWNER_CONTACT=the owner of this aqeelOS install

# --- Mail ---
MAIL_DOMAIN=example.com
MAIL_HELO=
# Domain for per-agent n8n login emails (agent@N8N_AGENT_EMAIL_DOMAIN).
N8N_AGENT_EMAIL_DOMAIN=example.com

# --- Backups / models ---
# Google account (gws --account name or email) that receives backups.
BACKUP_GOOGLE_ACCOUNT=
BACKUP_MODELS_RULES=

# --- Optional: NordVPN egress (scripts/nord-vpn.sh) ---
NORD_VPN_CONF=
# File holding the NordVPN service password (never put the password itself here).
NORD_PASSWORD_FILE=

# --- Optional: n8n compose (scripts/n8n-compose.yml) ---
N8N_HOST=n8n.example.com
AQEELOS_UPSTREAM=aqeelos:4400

# ======================================================================================================================
# Everything below is also read by the code, and every line is commented out: leave it so unless you need that setting.
# The values shown are safe examples, not defaults you must copy. (Audit 06: 97 names were read and not listed; scripts/debt.test.mjs
# fails when the code reads a new one that is not listed here, with a "# NAME=" line or a plain one.)
# ======================================================================================================================

# --- Sign-in apps and who may message an agent (engine channel settings, read from the engine's own .env too) ---
# Bot token of the Telegram bot the Channels page checks (the engine reads the same name).
# TELEGRAM_BOT_TOKEN=
# Slack bot token, and the user token used when there is no bot token.
# SLACK_BOT_TOKEN=
# SLACK_USER_TOKEN=
# Discord bot token.
# DISCORD_BOT_TOKEN=
# Comma-separated ids allowed to message an agent on each channel; empty list plus a pairing policy means people pair first.
# TELEGRAM_ALLOWED_USERS=123456789
# SLACK_ALLOWED_USERS=U0123ABCD
# WHATSAPP_ALLOWED_USERS=6281234567890
# WHATSAPP_GROUP_ALLOWED_USERS=
# 1 = anyone may message the agent (leave off for a customer-facing install).
# GATEWAY_ALLOW_ALL_USERS=0
# GATEWAY_ALLOWED_USERS=
# pairing = unknown people get a pairing code, ignore = they get no answer.
# WHATSAPP_DM_POLICY=pairing
# Where the WhatsApp bridge answers on this machine.
# WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
# Base address of the Kirimdev API (only to point a test at a fake one).
# KIRIMDEV_API=https://api.kirimdev.com/v1
# Tebar API key for scripts/run-check.mjs --comments (read from the agent's own .env when empty).
# TEBAR_API_KEY=

# --- Agents, owner and the AI box ---
# The main agent's profile name (default: default).
# MAIN_AGENT=default
# The built-in help agent's profile name.
# HELP_AGENT=aqeelos-help
# 1 = a test copy may also create the help agent (the live copy always does).
# HELP_ENSURE=0
# Name and username the owner account gets on first start (then change them in the app).
# OWNER_NAME=Owner
# OWNER_USERNAME=owner
# Host and port people use to SSH into an agent's home on the AI box, and the user they sign in as.
# SSH_HOST=box.example.com
# SSH_PORT=2222
# SSH_USER=claude
# Comma-separated SSH key fingerprints that may never be removed from the box.
# SSH_PROTECTED_FP=
# 1 = sharing levels are on (also switched in the app).
# SHARING_LEVELS=0
# Where the sign-in gate of published live apps asks whether a visitor may enter.
# LIVE_AUTH_URL=http://ai-box:4400/live-auth
# Shared secret of the online Code gate (set the same value on the Code host).
# CODE_GATE_SECRET=
# Where the desktop app installers are downloaded from (a GitHub releases address).
# DESKTOP_RELEASES=https://github.com/OWNER/REPO/releases/latest/download
# 1 = this process runs under a keeper loop that restarts it (set by the service wrapper).
# AQ_KEEPER=1
# The repository this install updates itself from (owner/name), and the checks that must pass before it does.
# AQ_REPO=OWNER/REPO
# AQ_REPO_SLUG=OWNER/REPO
# AQ_REQUIRED_CHECKS=tests.yml
# AQ_CHECKS_API=https://api.github.com
# A command that restarts the app after an automatic update (default: the service's own restart).
# AQ_UPDATE_RESTART=
# The folder of this app for scripts/auto-update.mjs (default: the folder above scripts/).
# AQEELOS_APP=
# Folder of the data (users.json and the rest) for scripts that run outside the app; default UI_DATA_DIR.
# AQEELOS_DATA=
# GitHub token the fixers use to open pull requests (or put it in <data>/fixer-github-token).
# AQEELOS_FIXER_GITHUB_TOKEN=
# Where the skills policy file is (default: <data>/skills-policy.json).
# AQEELOS_SKILLS_POLICY=
# How long a request to wake a sleeping agent waits, in milliseconds.
# AQ_WAKE_WAIT_MS=90000
# JSON of the job when app/backup-job.mjs is started by the app (never set by hand).
# AQ_BACKUP_JOB=
# Branding look: main colour and accent colour (hex) of this install's icons and header.
# AQEELOS_BRAND_COLOUR=#111111
# AQEELOS_BRAND_ACCENT=#83b271
# Closing-stage reminders (scripts/close-stage-due.mjs): path of its settings file.
# CLOSE_STAGE_CONFIG=
# Claude account folder used while signing in an account (set by the app for the sign-in it runs).
# CLAUDE_CONFIG_DIR=
# Delivery check (scripts/delivery-check.mjs): shortest wait and pickup time, in seconds.
# DELIVERY_CHECK_LIMIT_MIN_S=30
# DELIVERY_CHECK_PICKUP_S=
# Controls check: a JSON file of local overrides (scripts/controls-check.mjs).
# CONTROLS_LOCAL=
# Agent name the AdsPower bridge and guard act for, the bridge port and the AdsPower address.
# ADSPOWER_NAME=agent-name
# ADSPOWER_AGENT=agent-name
# ADSPOWER_KEY_AGENT=default
# ADSPOWER_API=http://127.0.0.1:50325
# BRIDGE_AGENT=default
# BRIDGE_PORT=9333
# PORT=50325

# --- Tests, checks and test copies (never on the live copy) ---
# 1 = a test copy (not live) may use a fake home for the accounts pages; the three below point it at fakes.
# ACCOUNTS_TEST=0
# ACCOUNTS_WORK=
# ACCOUNTS_SLACK_API=
# ACCOUNTS_GOOGLE_REVOKE=
# 1 = a test copy may run the backup-models step against a fake home.
# BACKUP_MODELS_TEST=0
# 1 = a test copy describes schedules too (the live copy always does).
# SCHED_DESCRIBE=0
# 1 = switch the online Code feature on in a test (the app setting is System › Settings).
# ONLINE_CODE=0
# Set by node --test: tells code that depends on timing to stand still.
# NODE_TEST_CONTEXT=
# Where the test suite finds the Code app and a Python 3 (tests only).
# AQEELOS_CODE_DIR=
# PYTHON=python3
# Private word list for the privacy test (a JSON file outside the repo; CI gets it as a secret).
# AQEELOS_PRIVATE_WORDS=
# The agent the live test and the end-to-end check use, and the agent the duplicate check creates.
# LIVE_TEST_AGENT=aq-livetest
# E2E_AGENT=default
# TEST_AGENT=dp-test
# Browser checks (scripts/pages-check.mjs, dup-check.mjs, ask-agent.mjs): address of the app, a file with the password or cookie, page size, output folder, one page.
# BASE=http://127.0.0.1:4400
# PWFILE=
# COOKIEFILE=
# NAME=
# W=1280
# H=900
# OUT=
# ONLY=
# Flicker check (scripts/flicker-ci.mjs): path of Chrome and the pages it visits.
# CHROME=/usr/bin/google-chrome
# FLICKER_PAGES=#/chat #/system/settings
# Debug log of the Kirimdev test (tests only).
# KDLOG=

# --- From the operating system, CI or the shell (read, never set in this file) ---
# HOME=
# PATH=
# USER=
# LANG=
# TZ=Asia/Jakarta
# TMPDIR=
# DISPLAY=:1
# APPDATA=
# LOCALAPPDATA=
# USERPROFILE=
# CI=
# GITHUB_REPOSITORY=
# GITHUB_TOKEN=
# GITHUB_OUTPUT=
# GITHUB_STEP_SUMMARY=
# PR_NUMBER=
# GIT_CONFIG_COUNT=
# GIT_CONFIG_KEY_0=
# GIT_CONFIG_VALUE_0=
