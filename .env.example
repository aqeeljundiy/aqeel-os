# aqeelOS web app settings. You do not need this file: scripts/install.sh sets aqeelOS up, the engine keys are read
# from ~/.hermes/.env, UI_SECRET is made on first start, and the address, time zone and hosts are set in the app
# (System › Settings › This install). Use a copy OUTSIDE the repo (the installer's service reads
# ~/.config/aqeelos/aqeelos.env) only to override something; a value here wins over the app's setting.
# Every value is optional; code defaults are neutral (localhost).

# --- Sign-in ---
# Hash: node app/server.mjs hash 'your password'
UI_PASSWORD_HASH=
# Made on first start and kept in UI_DATA_DIR/ui-secret; set it here only to choose your own. Changing it signs everyone out.
UI_SECRET=
UI_SESSION_DAYS=30
# Set to 1 only for local http development (cookies without Secure).
UI_INSECURE_COOKIE=

# --- Where the app listens / stores data ---
UI_HOST=127.0.0.1
UI_PORT=4400
# Defaults to ../hermes-ui-data next to the repo.
UI_DATA_DIR=
UI_LOG=

# --- Engine (Hermes Agent) connection ---
HERMES_DASH=http://127.0.0.1:9119
HERMES_API=http://127.0.0.1:8642
HERMES_WEBHOOKS=http://127.0.0.1:8644
HERMES_WA_CLOUD=http://127.0.0.1:8090
# Defaults to ~/.hermes (a leading ~ is expanded).
HERMES_HOME=
HERMES_BIN=
CLAUDE_BIN=
# Read from the engine's ~/.hermes/.env when empty (gateway API key and dashboard session token).
API_SERVER_KEY=
HERMES_DASHBOARD_SESSION_TOKEN=
# Unix account home used by scripts (agent-users.sh, nord-vpn.sh).
# Defaults to $HOME.
AQEELOS_HOME=

# --- Public addresses of this install (set in the app; a value here wins) ---
# 1 = the live copy (runs the jobs that change agents), 0 = a test copy. Empty: live only on port 4400.
AQEELOS_LIVE=
PUBLIC_URL=
# Proxies whose forwarding headers (cf-connecting-ip, x-forwarded-for) are believed: addresses or CIDR ranges, comma separated. Default: loopback
# (the reverse proxy or tunnel runs on this host). If your proxy reaches the app from a private network (a Docker network), list that range, e.g.
# TRUSTED_PROXIES=127.0.0.1,::1,10.0.1.0/24. Anything else is identified by its socket address (the sign-in limit counts per address).
TRUSTED_PROXIES=
N8N_URL=
# Domain for agent-published live sites (<name>.LIVE_DOMAIN).
LIVE_DOMAIN=
CODE_HOST=
CODE_PREVIEW_HOST=
UI_SCREEN=http://127.0.0.1:6080

# --- Branding / contact ---
# Engine persona: also settable as branding.name / branding.maker in ~/.hermes/config.yaml.
AQEELOS_BRAND_NAME=aqeelOS
AQEELOS_BRAND_MAKER=
BRAND_LOGO_FALLBACK=/assets/aqeelos-mark.svg
# Shown to people when something needs the owner ("ask <OWNER_CONTACT>").
OWNER_CONTACT=the owner of this aqeelOS install

# --- Mail ---
MAIL_DOMAIN=example.com
MAIL_HELO=
# Domain for per-agent n8n login emails (agent@N8N_AGENT_EMAIL_DOMAIN).
N8N_AGENT_EMAIL_DOMAIN=example.com

# --- Backups / models ---
# Google account (gws --account name or email) that receives backups.
BACKUP_GOOGLE_ACCOUNT=
BACKUP_MODELS_RULES=

# --- Optional: NordVPN egress (scripts/nord-vpn.sh) ---
NORD_VPN_CONF=
# File holding the NordVPN service password (never put the password itself here).
NORD_PASSWORD_FILE=

# --- Optional: n8n compose (scripts/n8n-compose.yml) ---
N8N_HOST=n8n.example.com
AQEELOS_UPSTREAM=aqeelos:4400
