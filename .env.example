# aqeelOS web app settings. Copy to a file OUTSIDE the repo (e.g. ~/apps/aqeelos.env) and run:
#   node --env-file=~/apps/aqeelos.env app/server.mjs
# Every value is optional unless marked REQUIRED; code defaults are neutral (localhost).

# --- Sign-in (REQUIRED) ---
# Hash: node app/server.mjs hash 'your password'
UI_PASSWORD_HASH=
# Long random string; changing it signs everyone out.
UI_SECRET=
UI_SESSION_DAYS=30
# Set to 1 only for local http development (cookies without Secure).
UI_INSECURE_COOKIE=

# --- Where the app listens / stores data ---
UI_HOST=127.0.0.1
UI_PORT=4400
# Defaults to ../hermes-ui-data next to the repo.
UI_DATA_DIR=
UI_LOG=

# --- Engine (Hermes Agent) connection ---
HERMES_DASH=http://127.0.0.1:9119
HERMES_API=http://127.0.0.1:8642
HERMES_WEBHOOKS=http://127.0.0.1:8644
HERMES_WA_CLOUD=http://127.0.0.1:8090
# Defaults to ~/.hermes (a leading ~ is expanded).
HERMES_HOME=
HERMES_BIN=
CLAUDE_BIN=
# Keys from the engine's ~/.hermes/.env (gateway API key and dashboard session token).
API_SERVER_KEY=
HERMES_DASHBOARD_SESSION_TOKEN=
# Unix account home used by scripts (agent-users.sh, nord-vpn.sh).
# Defaults to $HOME.
AQEELOS_HOME=

# --- Public addresses of this install ---
PUBLIC_URL=https://ai.example.com
N8N_URL=https://n8n.example.com
# Domain for agent-published live sites (<name>.LIVE_DOMAIN).
LIVE_DOMAIN=app.example.com
CODE_HOST=code.example.com
CODE_PREVIEW_HOST=code-preview.example.com
UI_SCREEN=http://127.0.0.1:6080

# --- Branding / contact ---
# Engine persona: also settable as branding.name / branding.maker in ~/.hermes/config.yaml.
AQEELOS_BRAND_NAME=aqeelOS
AQEELOS_BRAND_MAKER=
BRAND_LOGO_FALLBACK=/assets/aqeelos-mark.svg
# Shown to people when something needs the owner ("ask <OWNER_CONTACT>").
OWNER_CONTACT=the owner of this aqeelOS install

# --- Mail ---
MAIL_DOMAIN=example.com
MAIL_HELO=
# Domain for per-agent n8n login emails (agent@N8N_AGENT_EMAIL_DOMAIN).
N8N_AGENT_EMAIL_DOMAIN=example.com

# --- Backups / models ---
# Google account (gws --account name or email) that receives backups.
BACKUP_GOOGLE_ACCOUNT=
BACKUP_MODELS_RULES=

# --- Optional: NordVPN egress (scripts/nord-vpn.sh) ---
NORD_VPN_CONF=
# File holding the NordVPN service password (never put the password itself here).
NORD_PASSWORD_FILE=

# --- Optional: n8n compose (scripts/n8n-compose.yml) ---
N8N_HOST=n8n.example.com
AQEELOS_UPSTREAM=aqeelos:4400
