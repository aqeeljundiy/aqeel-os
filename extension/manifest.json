{
  "manifest_version": 3,
  "name": "aqeelOS: use my browser",
  "version": "2.1.0",
  "description": "Lets your aqeelOS agents work in this browser when you choose it, with a side chat next to the page. You always see what the agent is doing, and can stop it or take over.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "sidePanel",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "aqeelOS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "key": "",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-chat": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Open the aqeelOS side chat"
    }
  }
}