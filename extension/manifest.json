{
  "manifest_version": 3,
  "name": "aqeelOS: use my browser",
  "version": "1.1.0",
  "description": "Lets your aqeelOS agents work in this browser when you choose it, with aqeelOS open in the side panel next to the page.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "sidePanel",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "aqeelOS",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "key": "",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
