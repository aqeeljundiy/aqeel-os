diff --git a/gateway/telegram_group_digest.py b/gateway/telegram_group_digest.py
new file mode 100644
index 00000000..e94d48ff
--- /dev/null
+++ b/gateway/telegram_group_digest.py
@@ -0,0 +1,95 @@
+"""Telegram forum groups: 1 group = 1 session, 1 topic = sub-session.
+
+Each topic keeps its own session (own thread, replies stay in that topic), but every turn
+also sees a rolling, API-only digest of the latest messages from the group's other topics,
+each labelled with its topic name. Nothing is persisted into the topic's transcript.
+
+Settings (env, default on): HERMES_TELEGRAM_CROSS_TOPIC_CONTEXT=0 turns it off;
+HERMES_TELEGRAM_CROSS_TOPIC_MESSAGES (default 8 per topic), HERMES_TELEGRAM_CROSS_TOPIC_CHARS
+(default 6000 total).
+"""
+from __future__ import annotations
+
+import logging
+import os
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+
+def _enabled() -> bool:
+    return os.getenv("HERMES_TELEGRAM_CROSS_TOPIC_CONTEXT", "1").strip().lower() not in ("0", "false", "no", "off")
+
+
+def _int_env(name: str, default: int) -> int:
+    try:
+        return max(0, int(os.getenv(name, default)))
+    except (TypeError, ValueError):
+        return default
+
+
+def _text(content: Any) -> str:
+    if isinstance(content, str):
+        return content.strip()
+    if isinstance(content, list):
+        return " ".join(p.get("text", "") for p in content if isinstance(p, dict) and p.get("type") == "text").strip()
+    return ""
+
+
+def build_cross_topic_digest(session_store: Any, source: Any, current_session_key: str) -> Optional[str]:
+    """Latest messages from the other topics of the same Telegram group, labelled by topic."""
+    if not _enabled() or source is None:
+        return None
+    platform = getattr(getattr(source, "platform", None), "value", getattr(source, "platform", None))
+    if str(platform) != "telegram" or getattr(source, "chat_type", None) not in ("group", "supergroup", "forum"):
+        return None
+    chat_id = str(getattr(source, "chat_id", "") or "")
+    if not chat_id or not getattr(source, "thread_id", None):
+        return None
+    per_topic = _int_env("HERMES_TELEGRAM_CROSS_TOPIC_MESSAGES", 8)
+    budget = _int_env("HERMES_TELEGRAM_CROSS_TOPIC_CHARS", 6000)
+    if not per_topic or not budget:
+        return None
+    entries = dict(getattr(session_store, "_entries", {}) or {})
+    blocks: list[tuple[Any, str]] = []
+    for key, entry in entries.items():
+        if key == current_session_key:
+            continue
+        origin = getattr(entry, "origin", None)
+        if origin is None or str(getattr(origin, "chat_id", "")) != chat_id:
+            continue
+        o_platform = getattr(getattr(origin, "platform", None), "value", getattr(origin, "platform", None))
+        if str(o_platform) != "telegram":
+            continue
+        try:
+            rows = session_store.load_transcript(entry.session_id)
+        except Exception as exc:  # a sibling's unreadable store must never break this turn
+            logger.debug("cross-topic digest: skip %s: %s", key, exc)
+            continue
+        lines = []
+        for row in rows:
+            if row.get("role") not in ("user", "assistant"):
+                continue
+            t = _text(row.get("content"))
+            if not t:
+                continue
+            who = "agent" if row.get("role") == "assistant" else "user"
+            lines.append(f"  {who}: {t[:500]}")
+        lines = lines[-per_topic:]
+        if not lines:
+            continue
+        label = getattr(origin, "chat_topic", None) or getattr(origin, "thread_id", None) or "General"
+        blocks.append((getattr(entry, "updated_at", None), f"[Topic: {label}]\n" + "\n".join(lines)))
+    if not blocks:
+        return None
+    blocks.sort(key=lambda b: (b[0] is None, b[0]), reverse=True)  # most recent topics first
+    out, used = [], 0
+    for _, b in blocks:
+        if used + len(b) > budget:
+            break
+        out.append(b)
+        used += len(b)
+    if not out:
+        return None
+    return ("Recent messages from other topics of this same Telegram group (the group is one "
+            "conversation; you are replying in the current topic only):\n" + "\n\n".join(out))
diff --git a/tests/gateway/test_telegram_cross_topic_digest.py b/tests/gateway/test_telegram_cross_topic_digest.py
new file mode 100644
index 00000000..687dbe8a
--- /dev/null
+++ b/tests/gateway/test_telegram_cross_topic_digest.py
@@ -0,0 +1,29 @@
+from datetime import datetime
+from types import SimpleNamespace as NS
+from gateway.config import Platform
+from gateway.telegram_group_digest import build_cross_topic_digest
+
+def _src(thread, topic=None, chat="-100"):
+    return NS(platform=Platform.TELEGRAM, chat_type="group", chat_id=chat, thread_id=thread, chat_topic=topic)
+
+class Store:
+    def __init__(self):
+        self._entries = {
+            "k:1": NS(session_id="s1", origin=_src("1", "General"), updated_at=datetime(2026,1,1)),
+            "k:2": NS(session_id="s2", origin=_src("2", "Leads"), updated_at=datetime(2026,1,2)),
+            "k:x": NS(session_id="sx", origin=_src("5", "Other", chat="-200"), updated_at=datetime(2026,1,3)),
+        }
+        self.t = {"s1": [{"role": "user", "content": "hello from general"}],
+                  "s2": [{"role": "user", "content": "lead came in"}, {"role": "assistant", "content": "noted"}],
+                  "sx": [{"role": "user", "content": "secret other group"}]}
+    def load_transcript(self, sid): return self.t[sid]
+
+def test_digest_includes_other_topics_same_group_only():
+    d = build_cross_topic_digest(Store(), _src("1", "General"), "k:1")
+    assert "[Topic: Leads]" in d and "lead came in" in d and "agent: noted" in d
+    assert "hello from general" not in d and "secret other group" not in d
+
+def test_off_switch_and_non_topic(monkeypatch):
+    assert build_cross_topic_digest(Store(), _src(None), "k:0") is None
+    monkeypatch.setenv("HERMES_TELEGRAM_CROSS_TOPIC_CONTEXT", "0")
+    assert build_cross_topic_digest(Store(), _src("1"), "k:1") is None
