@@ -0,0 +1,154 @@
+"""Shared skills (aqeelos:shared-skills): every profile reads the main profile's skills dir as its
+lowest tier, filtered by <root>/skills-scope.json; skill_manage edits make the profile's own copy."""
+
+import json
+import os
+from unittest.mock import patch
+
+import pytest
+
+
+def _skill(root, rel, body="Do things."):
+    d = root / rel
+    d.mkdir(parents=True)
+    name = rel.split("/")[-1]
+    (d / "SKILL.md").write_text(f"---\nname: {name}\ndescription: {name} skill\n---\n\n# {name}\n\n{body}\n")
+    return d
+
+
+@pytest.fixture
+def fleet(tmp_path):
+    root = tmp_path / ".hermes"
+    (root / "skills").mkdir(parents=True)
+    (root / "config.yaml").write_text("skills: {}\n")
+    _skill(root / "skills", "productivity/pretty-sheets", "House style.")
+    _skill(root / "skills", "productivity/aqeel-task-hub", "Owner only.")
+    _skill(root / "skills", "pixel/pixel-ops", "Pixel only.")
+    for p in ("continue-support", "pixel-agent"):
+        h = root / "profiles" / p
+        (h / "skills").mkdir(parents=True)
+        (h / "config.yaml").write_text("skills: {}\n")
+    (root / "skills-scope.json").write_text(json.dumps({"skills": {
+        "productivity/aqeel-task-hub": ["default"], "pixel/pixel-ops": ["default", "pixel-agent"]}}))
+    return root
+
+
+def _clear():
+    from agent import skill_utils
+    skill_utils._external_dirs_cache_clear()
+    skill_utils._SCOPE_CACHE.clear()
+    skill_utils._SHARED_DIR_CACHE.clear()
+    skill_utils._PROFILE_CACHE.clear()
+    from tools import skills_tool
+    skills_tool.clear_skills_cache()
+
+
+def _as(fleet, profile):
+    home = fleet if profile == "default" else fleet / "profiles" / profile
+    from hermes_constants import set_hermes_home_override
+    _clear()
+    return patch.dict(os.environ, {"HERMES_HOME": str(home)}), home
+
+
+def _names():
+    from tools.skills_tool import skills_list
+    return {s["name"] for s in json.loads(skills_list())["skills"]}
+
+
+def test_profile_sees_universal_not_private(fleet):
+    env, _ = _as(fleet, "continue-support")
+    with env:
+        names = _names()
+    assert "pretty-sheets" in names
+    assert "aqeel-task-hub" not in names and "pixel-ops" not in names
+
+
+def test_shared_with_named_agent(fleet):
+    env, _ = _as(fleet, "pixel-agent")
+    with env:
+        names = _names()
+    assert {"pretty-sheets", "pixel-ops"} <= names and "aqeel-task-hub" not in names
+
+
+def test_skill_view_refuses_private(fleet):
+    env, _ = _as(fleet, "continue-support")
+    with env:
+        from tools.skills_tool import skill_view
+        assert json.loads(skill_view("pretty-sheets"))["success"] is True
+        assert json.loads(skill_view("aqeel-task-hub")).get("success") is not True
+
+
+def test_main_profile_has_no_shared_tier(fleet):
+    env, _ = _as(fleet, "default")
+    with env:
+        from agent.skill_utils import get_shared_skills_dir
+        assert get_shared_skills_dir() is None
+        assert {"pretty-sheets", "aqeel-task-hub", "pixel-ops"} <= _names()
+
+
+def test_no_scope_file_fails_closed(fleet):
+    (fleet / "skills-scope.json").unlink()
+    env, _ = _as(fleet, "continue-support")
+    with env:
+        assert "pretty-sheets" not in _names()
+
+
+def test_opt_out(fleet):
+    (fleet / "profiles" / "continue-support" / "config.yaml").write_text("skills:\n  shared: false\n")
+    env, _ = _as(fleet, "continue-support")
+    with env:
+        assert "pretty-sheets" not in _names()
+
+
+def test_own_copy_wins(fleet):
+    _skill(fleet / "profiles" / "continue-support" / "skills", "productivity/pretty-sheets", "Mine.")
+    env, _ = _as(fleet, "continue-support")
+    with env:
+        from tools.skills_tool import skill_view
+        assert "Mine." in json.loads(skill_view("pretty-sheets"))["content"]
+
+
+def test_patch_makes_own_copy_shared_unchanged(fleet):
+    shared_md = fleet / "skills" / "productivity" / "pretty-sheets" / "SKILL.md"
+    before = shared_md.read_text()
+    env, home = _as(fleet, "continue-support")
+    with env:
+        from tools.skill_manager_tool import skill_manage
+        r = json.loads(skill_manage(action="patch", name="pretty-sheets",
+                                    old_string="House style.", new_string="House style, Continue."))
+        assert r["success"] is True, r
+        own = home / "skills" / "productivity" / "pretty-sheets" / "SKILL.md"
+        assert "House style, Continue." in own.read_text()
+        assert shared_md.read_text() == before
+        _clear()
+        from tools.skills_tool import skill_view
+        assert "House style, Continue." in json.loads(skill_view("pretty-sheets"))["content"]
+
+
+def test_batch_failure_removes_new_copy(fleet):
+    env, home = _as(fleet, "continue-support")
+    with env:
+        from tools.skill_manager_tool import skill_manage
+        r = json.loads(skill_manage(action="patch", name="pretty-sheets", operations=[
+            {"action": "patch", "name": "pretty-sheets", "old_string": "House style.", "new_string": "X."},
+            {"action": "patch", "name": "pretty-sheets", "old_string": "not there", "new_string": "Y"}]))
+        assert r["success"] is False
+        assert not (home / "skills" / "productivity" / "pretty-sheets").exists()
+
+
+def test_delete_shared_refused(fleet):
+    env, _ = _as(fleet, "continue-support")
+    with env:
+        from tools.skill_manager_tool import skill_manage
+        r = json.loads(skill_manage(action="delete", name="pretty-sheets"))
+        assert r["success"] is False and "shared skill" in r["error"]
+    assert (fleet / "skills" / "productivity" / "pretty-sheets" / "SKILL.md").exists()
+
+
+def test_private_not_pushed_to_sandbox(fleet):
+    env, _ = _as(fleet, "continue-support")
+    with env:
+        from tools.credential_files import iter_skills_files
+        paths = [e["host_path"] for e in iter_skills_files("/remote/.hermes")]
+    assert any("pretty-sheets" in p for p in paths)
+    assert not any("aqeel-task-hub" in p or "pixel-ops" in p for p in paths)
