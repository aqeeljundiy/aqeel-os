+# --- Shared skills (aqeelos:shared-skills) -------------------------------------------------------
+# Every profile also reads the main profile's skills dir (<root>/skills), installed once, as its
+# lowest-precedence external tier. Which of those skills a profile may see is data, not code: the
+# scope file <root>/skills-scope.json ({"skills": {"<category>/<skill>": ["<profile>", ...]}}; a
+# skill not listed is for everyone; "default" is the main profile; "name--copy" counts as "name").
+# No scope file means no shared tier (fail closed: nothing private leaks before the owner's app
+# wrote one). ``skills.shared: false`` in a profile's config switches the tier off for it. The
+# tier is read-only to that profile: skill_manage edits copy the skill into the profile's own
+# skills dir first (copy-on-write), the curator treats it as external, sandboxes never sync back.
+SHARED_SCOPE_FILE = "skills-scope.json"
+_SCOPE_CACHE: dict[str, tuple[tuple, dict[str, frozenset]]] = {}
+_PROFILE_CACHE: dict[str, str] = {}
+_SHARED_DIR_CACHE: dict[tuple, Optional[Path]] = {}
+
+
+def _shared_root() -> Optional[Path]:
+    try:
+        from hermes_constants import get_default_hermes_root
+        return get_default_hermes_root()
+    except Exception:
+        return None
+
+
+def current_skill_profile() -> str:
+    """Base profile name of the live HERMES_HOME (``default`` for the main one; ``x--2`` -> ``x``)."""
+    from hermes_constants import get_hermes_home, profile_name_for_home
+    home = str(get_hermes_home())
+    name = _PROFILE_CACHE.get(home)
+    if name is None:
+        try:
+            name = profile_name_for_home(home) or "custom"
+        except Exception:
+            name = "custom"
+        _PROFILE_CACHE[home] = name
+    return name.split("--")[0]
+
+
+def _load_scope() -> Optional[dict[str, frozenset]]:
+    """``{skill key: allowed base profiles}`` from the scope file (mtime cached), or None when absent/bad."""
+    root = _shared_root()
+    if root is None:
+        return None
+    path = root / SHARED_SCOPE_FILE
+    try:
+        st = path.stat()
+    except OSError:
+        return None
+    sig = (st.st_mtime_ns, st.st_size)
+    cached = _SCOPE_CACHE.get(str(path))
+    if cached is not None and cached[0] == sig:
+        return cached[1]
+    try:
+        import json
+        raw = json.loads(path.read_text(encoding="utf-8"))
+        skills = raw.get("skills") if isinstance(raw, dict) else None
+        if not isinstance(skills, dict):
+            raise ValueError("no 'skills' mapping")
+        scope = {str(k).strip("/"): frozenset(str(a).split("--")[0] for a in (v or []))
+                 for k, v in skills.items() if isinstance(v, (list, tuple))}
+    except Exception as exc:
+        logger.warning("Shared skills scope file %s unreadable (%s): shared skills are off", path, exc)
+        _SCOPE_CACHE[str(path)] = (sig, None)
+        return None
+    _SCOPE_CACHE[str(path)] = (sig, scope)
+    return scope
+
+
+def shared_scope_signature() -> tuple:
+    """Change signature of the scope file and this profile (catalog / prompt cache keys)."""
+    root = _shared_root()
+    try:
+        st = (root / SHARED_SCOPE_FILE).stat() if root is not None else None
+    except OSError:
+        st = None
+    return (current_skill_profile(), (st.st_mtime_ns, st.st_size) if st else None)
+
+
+def get_shared_skills_dir() -> Optional[Path]:
+    """The main profile's skills dir when this profile reads it as a shared tier, else None
+    (the main profile itself, ``skills.shared: false``, no scope file, or no such dir)."""
+    root = _shared_root()
+    if root is None:
+        return None
+    key = (str(get_skills_dir()), str(root), _config_cache_key(get_config_path()), shared_scope_signature()[1])
+    if key in _SHARED_DIR_CACHE:
+        return _SHARED_DIR_CACHE[key]
+    result = None
+    try:
+        shared = (root / "skills").resolve()
+        flag = _skills_cfg_get("shared")
+        off = flag is False or (isinstance(flag, str) and flag.strip().lower() in ("false", "no", "off", "0"))
+        if (not off and shared.is_dir() and shared != get_skills_dir().resolve()
+                and _load_scope() is not None):
+            result = shared
+    except OSError:
+        result = None
+    if len(_SHARED_DIR_CACHE) > 256:
+        _SHARED_DIR_CACHE.clear()
+    _SHARED_DIR_CACHE[key] = result
+    return result
+
+
+def shared_skill_key(path) -> Optional[str]:
+    """``category/skill`` relative path of *path* inside the shared dir (None when outside it)."""
+    shared = get_shared_skills_dir()
+    if shared is None:
+        return None
+    try:  # lexical only: this runs for every scanned SKILL.md (the shared dir is stored resolved)
+        rel = Path(str(path)).relative_to(shared)
+    except ValueError:
+        return None
+    return rel.as_posix()
+
+
+def is_out_of_scope_skill_path(path) -> bool:
+    """True when *path* is inside a shared skill this profile may not see (scope file)."""
+    rel = shared_skill_key(path)
+    if not rel or rel == ".":
+        return False
+    scope = _load_scope() or {}
+    me = current_skill_profile()
+    parts = rel.split("/")
+    for key, allowed in scope.items():
+        if me in allowed:
+            continue
+        # the rule's path, or the skill's own name anywhere in the path (a copy under another category)
+        if rel == key or rel.startswith(key + "/") or key.rsplit("/", 1)[-1] in parts:
+            return True
+    return False
+
+
+def is_shared_skill_path(path) -> bool:
+    """True when *path* lives in the shared (main profile's) skills dir read by this profile."""
+    return shared_skill_key(path) is not None
+
+
