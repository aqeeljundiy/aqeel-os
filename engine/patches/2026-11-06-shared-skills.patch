+def own_copy_of_shared_skill(skill_dir: Path):
+    """Copy-on-write (aqeelos:shared-skills): a shared skill (the main profile's, read by every agent)
+    is copied to the same ``category/name`` in this profile's own skills dir before any change, so the
+    change stays this agent's and the shared one is untouched. -> ``(own_dir, None)`` | ``(None, error)``."""
+    from agent.skill_utils import shared_skill_key
+    rel = shared_skill_key(skill_dir)
+    if not rel:
+        return None, f"'{skill_dir}' is not a shared skill."
+    own = _skills_dir() / rel
+    if (own / "SKILL.md").exists():
+        return own, None
+    if own.exists() or _is_path_redirect(own):
+        return None, f"Cannot make your own copy of '{rel}': {own} already exists and is not a skill."
+    from hermes_constants import mkdir_under_hermes_home
+    mkdir_under_hermes_home(own.parent)
+    tmp = own.with_name(f".{own.name}.copy-{os.getpid()}")
+    try:
+        shutil.rmtree(tmp, ignore_errors=True)
+        shutil.copytree(skill_dir, tmp, symlinks=False,
+                        ignore=shutil.ignore_patterns(".git", ".hub", ".archive", "__pycache__", "*.bak*"))
+        tmp.rename(own)
+    except OSError as exc:
+        shutil.rmtree(tmp, ignore_errors=True)
+        return None, f"Could not make your own copy of '{rel}': {exc}"
+    _COW_CREATED.add(str(own))
+    logger.info("skills: made this agent's own copy of shared skill %s at %s", rel, own)
+    return own, None
