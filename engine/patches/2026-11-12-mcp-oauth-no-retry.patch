+def _oauth_signin_pending(server_name: str, config: dict) -> bool:
+    """True for an OAuth server nobody has signed in to (no tokens on disk) when nothing can ask a person for one.
+
+    Every discovery pass used to build its provider again, fail with "non-interactive environment and no cached
+    tokens" and log a WARNING (Elkiya, 11 Nov 2026: Slack, 295 errors in 24 hours, one every five minutes, for a login
+    that only a person can make). Such a server is left alone until its tokens file appears: signing in writes it, and
+    the next discovery pass connects the server. A gateway with the dashboard's sign-in flow, or a terminal, is
+    not "non-interactive" and keeps its normal path."""
+    try:
+        if (config.get("auth") or "").lower().strip() != "oauth":
+            return False
+        from hermes_constants import get_hermes_home
+        from tools.mcp_dashboard_oauth import get_dashboard_oauth_flow
+        from tools.mcp_oauth import HermesTokenStorage, _is_interactive
+        if get_dashboard_oauth_flow() is not None or _is_interactive():
+            return False
+        return not HermesTokenStorage(server_name, hermes_home=get_hermes_home()).has_cached_tokens()
+    except Exception:
+        return False
+
