+def stop_idle_harness_daemons(max_idle_s: float, now: Optional[float] = None) -> list:
+    """aqeelos:harness-idle-stop — stop the daemons this process drove that ran no call for ``max_idle_s``
+    seconds (never one with a call running), through the same ``--reload`` as ``stop_harness_daemons``."""
+    now = time.time() if now is None else now
+    with _driven_daemons_lock:
+        for key in [k for k in _daemon_last_used if k not in _driven_daemons]:
+            _daemon_last_used.pop(key, None)
+        idle = sorted(key for key in _driven_daemons
+                      if not _daemon_inflight.get(key) and now - _daemon_last_used.get(key, now) > max_idle_s)
+        for key in idle:
+            _driven_daemons.pop(key, None)
+            _daemon_last_used.pop(key, None)
+    _reload_daemons(idle)
+    return idle
+
