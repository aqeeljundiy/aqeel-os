index 0000000..b28f4e0
--- /dev/null
+++ b/agent/aqeelos_route.py
@@ -0,0 +1,207 @@
+"""aqeelOS route order: when a run may leave the model it was asked for.
+
+Elkiya, 11 Nov 2026: 9 of 34 fixer runs that asked for a Claude model ran on GPT or Gemini, and so did agents' chats and
+schedules (biomarkers-support, continue-support, continue-threads, pepclub-social, the main agent: 241 replies answered on a fallback in the logs of 9-12 Nov).
+The engine's fallback chain fired on the FIRST failed call, whatever the failure was: a short "Server is temporarily limiting
+requests (not your usage limit)" 429 (classified as billing), a timeout, an engine ValueError (P&P pixel-agent: 483 times).
+
+The order, always (the app, accounts.mjs / route-order.mjs, does the parts it can; this module is the engine's part):
+  (a) the same model on another signed-in account of the pool that has room: the app moves the agent there, so the engine
+      does not leave the model while the app's policy file says such an account exists;
+  (b) a background run (fixer, schedule) waits when the reset is near (waitMinutes);
+  (c) the owner's explicit fallback list (fallback_providers, written by backup-models.mjs from Models > If an account fails),
+      in its order, only for a failure of the ACCOUNT (billing, used up, signed out), never for a transient error;
+  (d) otherwise the run stops, with the reason in the reply.
+Every switch and every refusal is one line in <HERMES_HOME>/logs/route-switches.jsonl (asked model, actual model, reason, step);
+the app reads it (backup-models.mjs) for the run, Usage and Health.
+
+Pure: no engine imports, so it is tested alone (tests/agent/test_aqeelos_route.py).
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import time
+from pathlib import Path
+
+POLICY_FILE = "aqeelos-route.json"
+LOG_FILE = "route-switches.jsonl"
+POLICY_FRESH_S = 15 * 60  # an older policy says nothing about the pool (the app writes it every 5 minutes)
+
+# FailoverReason values that mean "this ACCOUNT cannot answer": used up, no credit, signed out or refused.
+ACCOUNT_REASONS = frozenset({"billing", "rate_limit", "auth", "auth_permanent", "model_entitlement"})
+# Text of a limit that is not the account's: the provider's own short throttle (Claude's relay says "not your usage limit").
+TRANSIENT_TEXT = re.compile(
+    r"not your usage limit|temporarily limiting requests|holding outbound sends|zero egress while held|"
+    r"overloaded|try again in a (?:few|moment)|upstream-timeout|ETIMEDOUT|ECONNRESET|connection dropped",
+    re.I,
+)
+
+
+def family_of(model: str) -> str:
+    """claude / gpt / gemini / the model's own first word: the vendor family a person means by 'the same model'."""
+    m = str(model or "").lower()
+    if re.search(r"claude|opus|sonnet|haiku|fable", m):
+        return "claude"
+    if re.search(r"gpt|codex|\bo[134]\b", m):
+        return "gpt"
+    if "gemini" in m:
+        return "gemini"
+    return re.split(r"[-_/:.\s]", m, maxsplit=1)[0] if m else ""
+
+
+def reason_name(reason) -> str:
+    return str(getattr(reason, "value", reason) or "")
+
+
+def failure_class(reason, message: str = "") -> str:
+    """'account' (this account cannot answer), 'transient' (the provider hiccuped), 'other' (no failure named)."""
+    name = reason_name(reason)
+    if not name:
+        return "other"
+    if name in ACCOUNT_REASONS:
+        # a billing / rate_limit verdict on text that says the limit is not the account's stays transient
+        if name in ("billing", "rate_limit") and TRANSIENT_TEXT.search(str(message or "")):
+            return "transient"
+        return "account"
+    return "transient"
+
+
+def home_dir(home=None) -> Path:
+    if home:
+        return Path(home)
+    try:
+        from hermes_constants import get_hermes_home  # the engine's own, profile-aware
+        return Path(get_hermes_home())
+    except Exception:
+        return Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")
+
+
+def load_policy(home=None, now: float | None = None) -> dict:
+    """The app's per-agent policy ({} when missing or unreadable). Stale pool facts are dropped, never trusted."""
+    try:
+        p = json.loads((home_dir(home) / POLICY_FILE).read_text("utf-8"))
+        if not isinstance(p, dict):
+            return {}
+    except Exception:
+        return {}
+    now = time.time() if now is None else now
+    at = float(p.get("at") or 0) / 1000.0
+    if not at or now - at > POLICY_FRESH_S:
+        p = {**p, "pool": {}}
+    return p
+
+
+def is_background(env=None, platform: str = "") -> bool:
+    env = os.environ if env is None else env
+    return env.get("AQEELOS_FIXER") == "1" or str(platform or "").lower() in ("cron", "schedule")
+
+
+def run_kind(env=None, platform: str = "") -> str:
+    env = os.environ if env is None else env
+    if env.get("AQEELOS_FIXER") == "1":
+        return "fixer"
+    if str(platform or "").lower() in ("cron", "schedule"):
+        return "schedule"
+    return "chat"
+
+
+def decide(*, asked_model: str, cand_model: str, reason=None, message: str = "", policy: dict | None = None,
+           background: bool = False, reset_in_s: float | None = None) -> tuple[bool, str, str]:
+    """May a run asked for `asked_model` move to `cand_model`? -> (allowed, step, why).
+
+    step: 'same-family' | 'explicit' | 'pool' | 'wait' | 'not-account' ; why: one plain sentence for the reply and the record."""
+    policy = policy or {}
+    if family_of(asked_model) and family_of(asked_model) == family_of(cand_model):
+        return True, "same-family", "the same model family"
+    cls = failure_class(reason, message)
+    if cls != "account":
+        return False, "not-account", (
+            "it is not a failure of the account (" + (reason_name(reason) or "no failure named")
+            + "), so aqeelOS does not switch to another model; it retries instead")
+    pool = policy.get("pool") or {}
+    if pool.get("sameModelRoom"):
+        keys = ", ".join(str(k) for k in (pool.get("keys") or [])[:3])
+        return False, "pool", "another account of the same pool has room" + (" (" + keys + ")" if keys else "") + " and the agent is moved there"
+    wait_s = float(policy.get("waitMinutes") or 0) * 60
+    if background and reset_in_s is not None and 0 < reset_in_s <= wait_s:
+        return False, "wait", "the account is back in about %d minutes, and this run waits for it" % max(1, round(reset_in_s / 60))
+    return True, "explicit", "the owner's fallback list, in its order"
+
+
+def reset_in(reset_at, now: float | None = None):
+    """Seconds until a reset the provider named (epoch seconds, epoch ms or ISO text), None when unknown or past."""
+    if reset_at in (None, ""):
+        return None
+    now = time.time() if now is None else now
+    try:
+        v = float(reset_at)
+        if v > 1e11:
+            v /= 1000.0
+    except (TypeError, ValueError):
+        try:
+            from datetime import datetime
+            v = datetime.fromisoformat(str(reset_at).replace("Z", "+00:00")).timestamp()
+        except Exception:
+            return None
+    d = v - now
+    return d if d > 0 else None
+
+
+_last_noted: dict = {}
+
+
+def note(rec: dict, home=None, now: float | None = None) -> bool:
+    """Append one record to logs/route-switches.jsonl. A refusal repeats every few seconds, so the same one is kept once a minute."""
+    now = time.time() if now is None else now
+    try:
+        if rec.get("denied"):
+            key = (str(home or ""), rec.get("asked"), rec.get("candidate"), rec.get("step"))
+            if now - _last_noted.get(key, 0) < 60:
+                return False
+            _last_noted[key] = now
+        d = home_dir(home) / "logs"
+        d.mkdir(parents=True, exist_ok=True)
+        with open(d / LOG_FILE, "a", encoding="utf-8") as f:
+            f.write(json.dumps({"at": int(now * 1000), **rec}, ensure_ascii=False) + "\n")
+        return True
+    except Exception:
+        return False
+
+
+def gate(agent, reason, message, fb_provider, fb_model, reset_at=None, home=None, now: float | None = None) -> tuple[bool, str]:
+    """The engine's hook (chat_completion_helpers.try_activate_fallback): may this candidate be used? Records a refusal."""
+    try:
+        primary = getattr(agent, "_primary_runtime", None) or {}
+        asked = str(primary.get("model") or getattr(agent, "model", "") or "")
+        platform = str(getattr(agent, "platform", "") or "")
+        env_kind = run_kind(platform=platform)
+        ok, step, why = decide(
+            asked_model=asked, cand_model=fb_model, reason=reason, message=message, policy=load_policy(home, now),
+            background=is_background(platform=platform), reset_in_s=reset_in(reset_at, now))
+        if not ok:
+            note({"denied": True, "kind": env_kind, "platform": platform, "session": str(getattr(agent, "session_id", "") or ""),
+                  "asked": asked, "candidate": str(fb_model), "candidateProvider": str(fb_provider),
+                  "reason": reason_name(reason), "step": step, "why": why}, home, now)
+            try:
+                agent._buffer_diagnostic_status("Staying on %s: %s." % (asked or "the chosen model", why))
+            except Exception:
+                pass
+        return ok, why
+    except Exception:
+        return True, "route order could not be checked"  # never make a failing run worse
+
+
+def switched(agent, reason, old_model, old_provider, fb_model, fb_provider, why="", home=None) -> None:
+    """One line for a switch that happened: asked model, actual model, reason, which step allowed it."""
+    try:
+        primary = getattr(agent, "_primary_runtime", None) or {}
+        platform = str(getattr(agent, "platform", "") or "")
+        asked = str(primary.get("model") or old_model or "")
+        note({"kind": run_kind(platform=platform), "platform": platform, "session": str(getattr(agent, "session_id", "") or ""),
+              "asked": asked, "askedProvider": str(primary.get("provider") or old_provider or ""),
+              "actual": str(fb_model), "actualProvider": str(fb_provider), "reason": reason_name(reason),
+              "step": "same-family" if family_of(asked) == family_of(fb_model) else "explicit", "why": why}, home)
+    except Exception:
+        pass
