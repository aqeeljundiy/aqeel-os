diff --git a/tests/agent/test_aqeelos_route.py b/tests/agent/test_aqeelos_route.py
new file mode 100644
index 0000000..54d5c1d
--- /dev/null
+++ b/tests/agent/test_aqeelos_route.py
@@ -0,0 +1,118 @@
+"""Route order (agent/aqeelos_route.py): a run leaves the model it was asked for only in the owner's order."""
+import json
+import time
+
+from agent import aqeelos_route as r
+
+
+class Reason:  # stands in for FailoverReason (only .value is read)
+    def __init__(self, v):
+        self.value = v
+
+
+class Agent:
+    def __init__(self, model="claude-sonnet-5-5[1m]", provider="claude-sub", platform="telegram"):
+        self._primary_runtime = {"model": model, "provider": provider}
+        self.model, self.provider, self.platform, self.session_id = model, provider, platform, "s1"
+        self.said = []
+
+    def _buffer_diagnostic_status(self, t):
+        self.said.append(t)
+
+
+def _policy(tmp_path, **kw):
+    p = {"v": 1, "at": int(time.time() * 1000), "waitMinutes": 15, **kw}
+    (tmp_path / r.POLICY_FILE).write_text(json.dumps(p))
+
+
+def _lines(tmp_path):
+    f = tmp_path / "logs" / r.LOG_FILE
+    return [json.loads(x) for x in f.read_text().splitlines()] if f.exists() else []
+
+
+def test_family_of_names_the_vendor():
+    assert r.family_of("claude-opus-5-5[1m]") == "claude"
+    assert r.family_of("gpt-6.1-sol") == "gpt"
+    assert r.family_of("gemini-4-argon-high") == "gemini"
+
+
+def test_a_transient_429_is_not_an_account_failure():
+    msg = "HTTP 429: ... API Error: Server is temporarily limiting requests (not your usage limit) · upstream rate-limited"
+    assert r.failure_class(Reason("billing"), msg) == "transient"
+    assert r.failure_class(Reason("rate_limit"), msg) == "transient"
+    assert r.failure_class(Reason("billing"), "You've hit your session limit · resets 6pm (UTC)") == "account"
+    assert r.failure_class(Reason("timeout")) == "transient"
+    assert r.failure_class(None) == "other"
+
+
+def test_transient_errors_never_leave_the_model():
+    for reason in ("timeout", "overloaded", "server_error", "unknown", None):
+        ok, step, _ = r.decide(asked_model="claude-sonnet-5-5", cand_model="gpt-6.1-sol", reason=Reason(reason) if reason else None)
+        assert (ok, step) == (False, "not-account")
+
+
+def test_same_family_is_always_allowed():
+    ok, step, _ = r.decide(asked_model="claude-sonnet-5-5", cand_model="claude-opus-5-5", reason=Reason("timeout"))
+    assert (ok, step) == (True, "same-family")
+
+
+def test_pool_room_comes_first():
+    ok, step, why = r.decide(asked_model="claude-sonnet-5-5", cand_model="gpt-6.1-sol", reason=Reason("billing"),
+                             message="hit your session limit", policy={"pool": {"sameModelRoom": True, "keys": ["claude:b"]}})
+    assert (ok, step) == (False, "pool") and "claude:b" in why
+
+
+def test_background_waits_when_the_reset_is_near_chat_does_not():
+    kw = dict(asked_model="claude-opus-5-5", cand_model="gpt-6.1-sol", reason=Reason("rate_limit"),
+              message="You've hit your session limit", policy={"waitMinutes": 15}, reset_in_s=600)
+    assert r.decide(background=True, **kw)[:2] == (False, "wait")
+    assert r.decide(background=False, **kw)[:2] == (True, "explicit")
+    far = {**kw, "reset_in_s": 3 * 3600}
+    assert r.decide(background=True, **far)[:2] == (True, "explicit")
+
+
+def test_the_explicit_list_when_the_account_is_out():
+    ok, step, _ = r.decide(asked_model="claude-sonnet-5-5", cand_model="gemini-4-argon-high", reason=Reason("auth_permanent"))
+    assert (ok, step) == (True, "explicit")
+
+
+def test_a_stale_policy_says_nothing_about_the_pool(tmp_path):
+    (tmp_path / r.POLICY_FILE).write_text(json.dumps({"at": 1000, "pool": {"sameModelRoom": True}, "waitMinutes": 5}))
+    assert r.load_policy(tmp_path)["pool"] == {}
+    _policy(tmp_path, pool={"sameModelRoom": True})
+    assert r.load_policy(tmp_path)["pool"]["sameModelRoom"] is True
+    assert r.load_policy(tmp_path / "missing") == {}
+
+
+def test_gate_records_a_refusal_once_and_tells_the_reply(tmp_path):
+    a = Agent()
+    for _ in range(3):
+        ok, _ = r.gate(a, Reason("timeout"), "ECONNRESET", "openai-codex", "gpt-6.1-sol", home=tmp_path)
+        assert ok is False
+    rows = _lines(tmp_path)
+    assert len(rows) == 1 and rows[0]["denied"] and rows[0]["asked"].startswith("claude") and rows[0]["step"] == "not-account"
+    assert rows[0]["kind"] == "chat" and a.said and "Staying on claude" in a.said[0]
+
+
+def test_switched_writes_asked_actual_reason_and_kind(tmp_path):
+    a = Agent(platform="cron")
+    r.switched(a, Reason("billing"), a.model, a.provider, "gpt-6.1-sol", "openai-codex", "the owner's fallback list, in its order", home=tmp_path)
+    (row,) = _lines(tmp_path)
+    assert (row["kind"], row["asked"], row["actual"], row["reason"], row["step"]) == (
+        "schedule", "claude-sonnet-5-5[1m]", "gpt-6.1-sol", "billing", "explicit")
+
+
+def test_reset_in_reads_seconds_millis_and_iso():
+    now = 1_800_000_000
+    assert r.reset_in(now + 300, now) == 300
+    assert r.reset_in((now + 300) * 1000, now) == 300
+    assert r.reset_in(None, now) is None and r.reset_in(now - 5, now) is None
+    assert r.reset_in("2027-01-15T08:05:00Z", 1_800_000_000 - 3600 * 24 * 365) is not None
+
+
+def test_a_broken_check_never_blocks_a_failing_run(tmp_path):
+    class Bad:
+        @property
+        def _primary_runtime(self):
+            raise RuntimeError("boom")
+    assert r.gate(Bad(), Reason("billing"), "", "p", "m", home=tmp_path)[0] is True
