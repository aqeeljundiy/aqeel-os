diff --git a/scripts/whatsapp-bridge/group_watch.js b/scripts/whatsapp-bridge/group_watch.js
new file mode 100644
index 00000000..9c94798f
--- /dev/null
+++ b/scripts/whatsapp-bridge/group_watch.js
@@ -0,0 +1,75 @@
+// Local add-on (aqeelOS): READ-ONLY watch of chosen WhatsApp groups.
+// Groups are picked by name in <session>/../watch_groups.txt (one name per line).
+// Messages are only written to <session>/../group_watch/<group>/<date>.jsonl
+// (documents saved next to them). This never sends, reacts or marks as read,
+// and it runs before the reply gate, so watched groups can stay blocked for replies.
+import path from 'path';
+import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'fs';
+
+const nameCache = new Map();
+
+function watchedNames(base) {
+  const f = path.join(base, 'watch_groups.txt');
+  if (!existsSync(f)) return [];
+  return readFileSync(f, 'utf8').split('\n').map(s => s.trim().toLowerCase()).filter(Boolean);
+}
+
+function textOf(m) {
+  if (!m) return '';
+  const c = m.ephemeralMessage?.message || m.viewOnceMessage?.message || m.viewOnceMessageV2?.message || m;
+  if (c.conversation) return c.conversation;
+  if (c.extendedTextMessage?.text) return c.extendedTextMessage.text;
+  if (c.imageMessage) return '[photo]' + (c.imageMessage.caption ? ' ' + c.imageMessage.caption : '');
+  if (c.videoMessage) return '[video]' + (c.videoMessage.caption ? ' ' + c.videoMessage.caption : '');
+  if (c.audioMessage) return c.audioMessage.ptt ? '[voice note]' : '[audio]';
+  if (c.documentMessage) return '[file] ' + (c.documentMessage.fileName || '') + (c.documentMessage.caption ? ' ' + c.documentMessage.caption : '');
+  if (c.documentWithCaptionMessage?.message?.documentMessage) {
+    const d = c.documentWithCaptionMessage.message.documentMessage;
+    return '[file] ' + (d.fileName || '') + (d.caption ? ' ' + d.caption : '');
+  }
+  if (c.stickerMessage) return '[sticker]';
+  if (c.reactionMessage) return '[reaction] ' + (c.reactionMessage.text || '');
+  if (c.protocolMessage) return '';
+  return '[other]';
+}
+
+export async function watchGroupMessage(sock, sessionDir, msg, chatId, downloadMediaMessage) {
+  try {
+    if (!chatId || !chatId.endsWith('@g.us')) return;
+    const base = path.resolve(sessionDir, '..');
+    const names = watchedNames(base);
+    if (!names.length) return;
+    let name = nameCache.get(chatId);
+    if (!name) {
+      try { name = (await sock.groupMetadata(chatId)).subject || ''; } catch { name = ''; }
+      if (name) nameCache.set(chatId, name);
+    }
+    if (!name || !names.includes(name.trim().toLowerCase())) return;
+    const text = textOf(msg.message);
+    if (!text) return;
+    const slug = name.replace(/[^A-Za-z0-9]+/g, '-').replace(/^-|-$/g, '') || chatId;
+    const dir = path.join(base, 'group_watch', slug);
+    if (!existsSync(dir)) mkdirSync(dir, { recursive: true, mode: 0o700 });
+    writeFileSync(path.join(dir, 'chat_id.txt'), chatId + '\n');
+    const ts = Number(msg.messageTimestamp) ? Number(msg.messageTimestamp) * 1000 : Date.now();
+    const day = new Date(ts + 7 * 3600 * 1000).toISOString().slice(0, 10);
+    const entry = {
+      time: new Date(ts).toISOString(),
+      fromMe: !!msg.key?.fromMe,
+      sender: msg.key?.participantAlt || msg.key?.participant || '',
+      name: msg.pushName || '',
+      text: text.slice(0, 8000),
+    };
+    const c = msg.message;
+    const doc = c?.documentMessage || c?.documentWithCaptionMessage?.message?.documentMessage;
+    if (doc && downloadMediaMessage) {
+      try {
+        const buf = await downloadMediaMessage(msg, 'buffer', {});
+        const fname = `${day}_${(doc.fileName || 'file').replace(/[^\w.\- ]+/g, '_')}`;
+        writeFileSync(path.join(dir, fname), buf, { mode: 0o600 });
+        entry.saved_file = fname;
+      } catch (e) { entry.saved_file_error = String(e?.message || e).slice(0, 200); }
+    }
+    appendFileSync(path.join(dir, `${day}.jsonl`), JSON.stringify(entry) + '\n', { mode: 0o600 });
+  } catch {}
+}
diff --git a/scripts/whatsapp-bridge/inbox_log.js b/scripts/whatsapp-bridge/inbox_log.js
new file mode 100644
index 00000000..ed4fc0c8
--- /dev/null
+++ b/scripts/whatsapp-bridge/inbox_log.js
@@ -0,0 +1,54 @@
+// Local add-on (aqeelOS): read-only inbox log for direct chats.
+// Active only when <session>/../inbox_log.enabled exists. Text only, no groups/status,
+// files chmod 600, entries older than 7 days are deleted. Never sends anything.
+import path from 'path';
+import { appendFileSync, chmodSync, existsSync, mkdirSync, readdirSync, unlinkSync } from 'fs';
+
+const KEEP_DAYS = 7;
+
+function textOf(m) {
+  if (!m) return '';
+  const c = m.ephemeralMessage?.message || m.viewOnceMessage?.message || m.viewOnceMessageV2?.message || m;
+  if (c.conversation) return c.conversation;
+  if (c.extendedTextMessage?.text) return c.extendedTextMessage.text;
+  if (c.imageMessage) return '[photo]' + (c.imageMessage.caption ? ' ' + c.imageMessage.caption : '');
+  if (c.videoMessage) return '[video]' + (c.videoMessage.caption ? ' ' + c.videoMessage.caption : '');
+  if (c.audioMessage) return c.audioMessage.ptt ? '[voice note]' : '[audio]';
+  if (c.documentMessage) return '[file] ' + (c.documentMessage.fileName || '');
+  if (c.stickerMessage) return '[sticker]';
+  if (c.locationMessage || c.liveLocationMessage) return '[location]';
+  if (c.contactMessage) return '[contact] ' + (c.contactMessage.displayName || '');
+  if (c.reactionMessage) return '[reaction] ' + (c.reactionMessage.text || '');
+  if (c.protocolMessage) return '';
+  return '';
+}
+
+export function logInboxMessage(sessionDir, msg, { chatId, senderAltId }) {
+  try {
+    const base = path.resolve(sessionDir, '..');
+    if (!existsSync(path.join(base, 'inbox_log.enabled'))) return;
+    if (!chatId || chatId.endsWith('@g.us') || chatId.includes('broadcast') || chatId.endsWith('@newsletter')) return;
+    const text = textOf(msg.message);
+    if (!text) return;
+    const dir = path.join(base, 'inbox');
+    if (!existsSync(dir)) mkdirSync(dir, { recursive: true, mode: 0o700 });
+    const ts = Number(msg.messageTimestamp) ? Number(msg.messageTimestamp) * 1000 : Date.now();
+    const day = new Date(ts + 7 * 3600 * 1000).toISOString().slice(0, 10); // WIB date
+    const file = path.join(dir, `${day}.jsonl`);
+    const entry = {
+      time: new Date(ts).toISOString(),
+      fromMe: !!msg.key?.fromMe,
+      chat: chatId,
+      number: (senderAltId || '').endsWith('@s.whatsapp.net') ? senderAltId.split('@')[0] : '',
+      name: msg.key?.fromMe ? 'me' : (msg.pushName || ''),
+      text: text.slice(0, 4000),
+    };
+    appendFileSync(file, JSON.stringify(entry) + '\n', { mode: 0o600 });
+    try { chmodSync(file, 0o600); } catch {}
+    const cutoff = Date.now() - KEEP_DAYS * 86400 * 1000;
+    for (const f of readdirSync(dir)) {
+      const m = f.match(/^(\d{4}-\d{2}-\d{2})\.jsonl$/);
+      if (m && Date.parse(m[1] + 'T23:59:59+07:00') < cutoff) unlinkSync(path.join(dir, f));
+    }
+  } catch {}
+}
