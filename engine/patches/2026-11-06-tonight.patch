diff --git a/tools/environments/ssh.py b/tools/environments/ssh.py
index ce9ee7579a..f7ea1cd263 100644
--- a/tools/environments/ssh.py
+++ b/tools/environments/ssh.py
@@ -67,9 +67,10 @@ class SSHEnvironment(BaseEnvironment):
         # limit (raw user@host:port + SSH's 16-byte suffix under a deep $TMPDIR exceeds it), and
         # stability across reconnects keeps ControlMaster reuse working. A probe gets its own
         # per-instance socket so its cleanup() can never close the agent's shared master.
-        socket_key = f"{user}@{host}:{port}"
-        if probe_only:
-            socket_key = f"{socket_key}:probe:{self._session_id}"
+        # Every environment (one per chat) gets its own master: cleanup() sends ``-O exit``, and a
+        # master shared by all chats of one agent in a gateway cut off other chats' running
+        # commands (exit 255) whenever any one chat ended.
+        socket_key = f"{user}@{host}:{port}:{'probe' if probe_only else 'env'}:{self._session_id}"
         _socket_id = hashlib.sha256(socket_key.encode()).hexdigest()[:16]
         self.control_socket = self.control_dir / f"{_socket_id}.sock"
         _ensure_ssh_available()
