@@ -518,6 +518,46 @@ def apply_llm_output_transform(
         if isinstance(_hook_result, str) and _hook_result:
             pre_transform, final_response, transformed = final_response, _hook_result, True
             break
+    # aqeelos:backup-note: a backup model answered this turn: one short line under the reply
+    try:
+        _aq_fb = getattr(agent, "_provider_fallback_route", None) if getattr(agent, "_provider_fallback_active", False) else None
+        # aqeelos:backup-note-owner: only where the people running the agents read it, never to customers
+        _aq_where = str(platform or getattr(agent, "platform", "") or "").lower()
+        # aqeelos:fallback-notice: setting display.fallback_notice = owner_dm_only (default) | all | off.
+        # Never in groups or customer channels by default; every fallback is logged for health checks.
+        _aq_mode = "owner_dm_only"
+        try:
+            from hermes_cli.config import load_config as _aq_lc
+            _aq_mode = str(((_aq_lc() or {}).get("display") or {}).get("fallback_notice") or "owner_dm_only").lower()
+        except Exception:
+            pass
+        _aq_ok_here = _aq_where in ("api_server", "telegram", "slack", "discord")
+        if _aq_mode == "off":
+            _aq_ok_here = False
+        elif _aq_mode != "all" and _aq_where != "api_server":
+            try:
+                from gateway.session_context import get_session_env as _aq_ge
+                _aq_ok_here = _aq_ok_here and str(_aq_ge("HERMES_SESSION_CHAT_TYPE") or "").lower() == "dm"
+            except Exception:
+                _aq_ok_here = False
+        if isinstance(_aq_fb, (list, tuple)) and len(_aq_fb) == 2:
+            (logger or logging.getLogger(__name__)).warning("aqeelos-fallback-used platform=%s fallback=%s/%s notice_shown=%s", _aq_where, _aq_fb[0], _aq_fb[1], _aq_ok_here)
+        if _aq_ok_here and isinstance(_aq_fb, (list, tuple)) and len(_aq_fb) == 2 and isinstance(final_response, str) and final_response.strip():
+            def _aq_brand(p, m):
+                s = str(m or "").lower(); q = str(p or "").lower()
+                for k, n in (("claude", "Claude"), ("opus", "Claude"), ("sonnet", "Claude"), ("haiku", "Claude"), ("gpt", "GPT"), ("codex", "GPT"), ("gemini", "Gemini")):
+                    if k in s: return n
+                for k, n in (("claude", "Claude"), ("anthropic", "Claude"), ("openai", "GPT"), ("codex", "GPT"), ("gemini", "Gemini"), ("antigravity", "Gemini"), ("google", "Gemini")):
+                    if k in q: return n
+                return "another model"
+            _aq_prim = getattr(agent, "_primary_runtime", None) or {}
+            _aq_new, _aq_old = _aq_brand(_aq_fb[1], _aq_fb[0]), _aq_brand(_aq_prim.get("provider"), _aq_prim.get("model"))
+            if _aq_new != _aq_old and "(Answered with " not in final_response:
+                if not transformed:
+                    pre_transform = final_response
+                final_response, transformed = f"{final_response}\n\n(Answered with {_aq_new}, {_aq_old} was down.)", True
+    except Exception:
+        pass
     agent._llm_output_transform = (turn_id, transformed, pre_transform)
     return final_response, transformed, pre_transform
 
